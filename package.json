{
  "name": "wisery-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src",
    "dup": "jscpd src",
    "openspec:validate": "openspec validate --all --strict",
    "verify": "npm run typecheck && npm run openspec:validate && npm run lint && npm run format:check && npm run depcruise && npm run dup && npm run test:cov && npm run build",
    "verify:fast": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.6",
    "dependency-cruiser": "^16.10.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jscpd": "^4.2.3",
    "jsdom": "^29.1.1",
    "mermaid": "^11.15.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
