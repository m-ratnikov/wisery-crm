# Copy to .env (gitignored) and fill in. This example is committed.
# Dev points at a local Postgres on localhost:5433, database "wisery_crm".

# App (pooled) connection - used by Drizzle for request-path queries.
# In prod this is the pooled endpoint.
APP_DATABASE_URL=postgres://postgres:postgres@localhost:5433/wisery_crm

# Background-job connection - pg-boss owns its own pool (ADR-0001).
# Same DB as the app; in dev it is the same URL, in prod it is the direct
# (non-pooler) endpoint. Optional: falls back to APP_DATABASE_URL if unset.
PGBOSS_DATABASE_URL=postgres://postgres:postgres@localhost:5433/wisery_crm

# Pool sizes - budgeted together against the DB connection cap (ADR-0001).
APP_DB_POOL_MAX=10
PGBOSS_DB_POOL_MAX=5

# Logging: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# LLM (optional until qualify/draft features land)
# ANTHROPIC_API_KEY=

# Enrichment (optional; the Apify adapter needs it - enrichment is opt-in, ADR-0007)
# APIFY_API_TOKEN=

# Postgres-touching tests use this; unset = those tests skip.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/wisery_crm
